{
  "branches": ["master"],
  "tagFormat": "x2mail@${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    "@semantic-release/changelog",
    "@semantic-release/npm",
    ["@semantic-release/exec", {
      "prepareCmd": "bun run build && patchelf --set-interpreter /lib64/ld-linux-x86-64.so.2 release/x2mail-linux-x64 && upx release/x2mail-linux-arm64 -o release/x2mail-linux-arm64-lite && upx release/x2mail-linux-x64 -o release/x2mail-linux-x64-lite && ./.github/sfx-wrap.sh ${nextRelease.version}"
    }],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "CHANGELOG.md"],
        "message": "chore(release): x2mail@${nextRelease.version}\n\n${nextRelease.notes}",
        "authorName": "anakmagang",
        "authorEmail": "45801144+anakmagang@users.noreply.github.com"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release/x2mail-darwin-arm64",
            "label": "x2mail-darwin-arm64-${nextRelease.version}"
          },
          { "path": "release/x2mail-darwin-x64", "label": "x2mail-darwin-x64-${nextRelease.version}" },
          {
            "path": "release/x2mail-linux-arm64",
            "label": "x2mail-linux-arm64-${nextRelease.version}"
          },
          { "path": "release/x2mail-linux-x64", "label": "x2mail-linux-x64-${nextRelease.version}" },
          { "path": "release/x2mail-linux-arm64-lite", "label": "x2mail-linux-arm64-lite-${nextRelease.version}" },
          { "path": "release/x2mail-linux-x64-lite", "label": "x2mail-linux-x64-lite-${nextRelease.version}" },
          { "path": "release/x2mail-darwin-arm64-lite", "label": "x2mail-darwin-arm64-lite-${nextRelease.version}" },
          { "path": "release/x2mail-darwin-x64-lite", "label": "x2mail-darwin-x64-lite-${nextRelease.version}" }
        ]
      }
    ]
  ]
}
