{
  "name": "x2mail",
  "version": "1.0.2",
  "private": false,
  "description": "SMTP/POP3 ↔ HTTP email proxy — localhost bridge for mail clients",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/r17x/x2mail.git"
  },
  "bin": {
    "x2mail": "dist/bin.js"
  },
  "type": "module",
  "module": "dist/config.js",
  "exports": {
    ".": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run build.ts",
    "start": "bun run src/bin.ts",
    "test": "bun test",
    "prepare": "effect-tsgo patch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt src -- --check",
    "release": "semantic-release"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.108",
    "effect": "4.0.0-rc.108"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@types/bun": "1.2.12",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "semantic-release": "^24.1.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.108"
  }
}
